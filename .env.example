# Секрет сессий (обязательно смените на сервере)
SECRET_KEY=change-me-to-random-string

# База данных (на сервере файл остаётся на диске сервера)
DATABASE_URL=sqlite:///./data/zadachi.db

# Начальные пароли — используются ОДИН раз при первом запуске
PASS_NIKITA=change-me
PASS_ARTEM=change-me
PASS_ILYA=change-me
PASS_ANTON=change-me
PASS_SERGEY=change-me

# Telegram: исходящие уведомления/TXT в чат идей; входящие — из чата идей, подтверждение в личке
# Бот: @BotFather → токен; /setprivacy → Disable (чтобы видеть сообщения группы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Публичный URL сайта для ссылок в уведомлениях (без слэша в конце)
APP_BASE_URL=
# День месяца для автоэкспорта по умолчанию (1–28); дальше меняется в Настройках
TELEGRAM_MONTHLY_DAY=1

# Почта для ежемесячной выгрузки (TXT + gzip БД). Пример для Gmail: пароль приложения.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=1  # только если порт 465
